// The single source of truth for the database.
// Every business-owned table carries `tenantId`; the app only reaches them through
// `tenantDb()` (src/lib/tenant-db.ts), which adds that filter to every query.
// Money is always whole Kenyan shillings (Int), never floating point.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Businesses (tenants)
// ---------------------------------------------------------------------------

model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  // Public domain (e.g. "jaycvs.co.ke"); requests are matched to a business by host
  domain          String?  @unique
  orderPrefix     String   @default("JC")
  // Next order number to hand out; incremented inside the order-creating transaction
  nextOrderNumber Int      @default(1041)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  settings        BusinessSettings?
  homepage        Homepage?
  memberships     Membership[]
  invites         Invite[]
  jobs            Job[]
  companies       Company[]
  inboxItems      InboxItem[]
  orders          Order[]
  orderEvents     OrderEvent[]
  orderRevisions  OrderRevision[]
  payments        Payment[]
  files           StoredFile[]
  packages        Package[]
  services        Service[]
  reviews         Review[]
  samples         Sample[]
  posts           Post[]
  faqs            Faq[]
  contentChanges  ContentChange[]
  tokenEntries    TokenLedgerEntry[]
  payouts         WriterPayout[]
  trackingTries   TrackingAttempt[]
  cancelledOrders CancelledOrder[]
  cvChecks        CvCheck[]
  orderAiResults  OrderAiResult[]
  about           AboutPage?
}

enum MpesaMode {
  TEST
  LIVE
}

// The owner edits these in Admin → Website content → Business settings
model BusinessSettings {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsapp              String
  email                 String
  address               String
  channelLink           String?
  linkedinUrl           String?
  facebookUrl           String?
  instagramUrl          String?
  xUrl                  String?
  unpaidHours           Int       @default(24)
  reminderDays          Int       @default(2)
  autoCompleteDays      Int       @default(5)
  revisionHours         Int       @default(24)
  // Client files are deleted this many months after delivery
  retentionMonths       Int       @default(6)
  // Job posters are deleted this many months after the job closes
  posterRetentionMonths Int       @default(3)
  // Abandoned (never paid) orders are deleted this many days after they were placed
  deleteAbandonedDays   Int       @default(30)
  // What a client pays for "Check it yourself": AI feedback on their CV for one job (KES)
  cvCheckPrice          Int       @default(10)
  aiWarnPct             Int       @default(20)
  paybill               String
  mpesaMode             MpesaMode @default(TEST)
  updatedAt             DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Logins (Better Auth tables: field names follow its expected schema)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Team: who belongs to which business, and what they may do
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  WRITER
}

enum MemberStatus {
  ACTIVE
  PAUSED
  REMOVED
}

model Membership {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role
  status      MemberStatus @default(ACTIVE)
  displayName String
  // Set from the profile page; displayName is kept as the nickname, or "first last", for everywhere else
  firstName   String       @default("")
  lastName    String       @default("")
  nickname    String       @default("")
  phone       String?
  canWrite    Boolean      @default(true)
  canPostJobs Boolean      @default(false)
  // Writer's share of each order they deliver, in whole percent
  payPercent  Int          @default(0)
  joinedAt    DateTime     @default(now())
  lastSeenAt  DateTime?

  acceptedOrders Order[]            @relation("OrderWriter")
  payouts        WriterPayout[]
  invitesSent    Invite[]           @relation("InvitedBy")
  orderEvents    OrderEvent[]
  postsWritten   Post[]
  jobsCreated    Job[]
  inboxAdded     InboxItem[]        @relation("InboxAddedBy")
  inboxDecided   InboxItem[]        @relation("InboxDecidedBy")
  contentChanges ContentChange[]
  tokenEntries   TokenLedgerEntry[]
  orderAiResults OrderAiResult[]

  @@unique([tenantId, userId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// Sign-in is invite-only: a Google account may only be created for an email with a pending invite
model Invite {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Stored lower-case so matching the Google email is exact
  email       String
  name        String
  phone       String?
  role        Role         @default(WRITER)
  canWrite    Boolean      @default(true)
  canPostJobs Boolean      @default(false)
  payPercent  Int          @default(0)
  status      InviteStatus @default(PENDING)
  invitedById String?
  invitedBy   Membership?  @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  @@index([email, status])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Jobs board
// ---------------------------------------------------------------------------

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Job {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  company          String
  // The remembered employer (for its logo); set from the company name when the job is saved
  companyId        String?
  companyRef       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  location         String
  workMode         String
  type             String
  category         String
  summary          String
  responsibilities String[]
  requirements     String[]
  // Search tags; each has its own page on the website (modules/jobs/jobs.schema.ts cleanTags)
  tags             String[]    @default([])
  salary           String?
  postedAt         DateTime    @default(now())
  // null = open until filled
  deadline         DateTime?   @db.Date
  // How to apply; shape is validated by modules/jobs/jobs.schema.ts
  apply            Json
  source           String?
  status           JobStatus   @default(DRAFT)
  createdById      String?
  createdBy        Membership? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  files        StoredFile[]
  tokenEntries TokenLedgerEntry[]
  inboxItems   InboxItem[]
  orders       Order[]
  cvChecks     CvCheck[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, postedAt])
  @@index([companyId])
}

// Hiring companies, remembered so each logo is added once and reused on every job they post
model Company {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  // Lower-case, single-spaced name, so "Kilimall " and "kilimall" are the same company
  nameKey       String
  logoPath      String?
  logoUpdatedAt DateTime?
  createdAt     DateTime  @default(now())

  jobs Job[]

  @@unique([tenantId, nameKey])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW
  ABANDONED
  PAID
  WRITING
  DRAFT_SENT
  REVISIONS
  DELIVERED
}

model Order {
  id                  String      @id @default(cuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Shown as `${orderPrefix}-${number}`, e.g. JC-1048; also the M-Pesa account number
  number              Int
  status              OrderStatus @default(NEW)
  // Name of what was bought, copied at order time so later price list edits don't change it
  itemName            String
  packageId           String?
  package             Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  serviceId           String?
  service             Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  amount              Int
  // Timing rules copied from the package at order time
  firstDraftHours     Int
  // null = unlimited rounds within revisionWindowDays (counted from payment)
  revisionRounds      Int?
  revisionWindowDays  Int?
  extraHours          Int         @default(0)
  clientName          String
  clientPhone         String
  clientEmail         String?
  whatsappUpdates     Boolean     @default(true)
  targetRole          String?
  industry            String?
  experience          String?
  notes               String?
  // For a CV tailored to a job: the job on our board it was ordered from, and/or the advert the
  // client pasted (text or a link). An uploaded advert is a JOB_ADVERT file.
  jobId               String?
  job                 Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobAdvert           String?
  noCv                Boolean     @default(false)
  source              String      @default("website")
  // Only a hash of the private tracking-link token is stored, so a database leak can't reveal links
  trackingTokenHash   String      @unique
  // The same code encrypted with the server's secret, so staff can copy the link to resend it
  // (a database leak alone still can't reveal it)
  trackingTokenSealed String?
  writerId            String?
  writer              Membership? @relation("OrderWriter", fields: [writerId], references: [id], onDelete: SetNull)
  paidAt              DateTime?
  acceptedAt          DateTime?
  draftSentAt         DateTime?
  remindedAt          DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  events       OrderEvent[]
  revisions    OrderRevision[]
  payments     Payment[]
  files        StoredFile[]
  reviews      Review[]
  tokenEntries TokenLedgerEntry[]
  aiResults    OrderAiResult[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, writerId])
}

model OrderRevision {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  round       Int
  requestedBy String
  text        String
  requestedAt DateTime @default(now())

  @@unique([orderId, round])
}

// Something a visitor did that's counted to stop abuse: a wrong "Track my order" try (too many
// for one order, or from one visitor, and lookups pause for a while), or an order placed (too many
// from one visitor in an hour and the order card pauses). Old rows are deleted nightly.
model TrackingAttempt {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // "order:1048" or "visitor:<hash of the IP address>" (the address itself is never stored)
  key      String
  at       DateTime @default(now())

  @@index([tenantId, key, at])
}

// "Check it yourself": a client pays a small fee and the AI tells them how well their CV fits one
// job (match, strengths, gaps). Feedback only: it never writes a CV, and Jay gets no order. The CV
// is deleted as soon as it has been read.
enum CvCheckStatus {
  UNPAID
  PAID
  // The AI is reading it right now (so a second request can't start a second, paid-for reading)
  READING
  DONE
  FAILED
}

model CvCheck {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // "HR & Admin Team Lead at Kingdom Sacco", kept if the job is later removed
  jobLabel  String
  jobSlug   String
  phone     String
  amount    Int
  status    CvCheckStatus @default(UNPAID)
  // The uploaded CV (private "order-files" bucket) until the AI has read it; then null
  cvPath    String?
  cvName    String
  cvType    String
  // The AI's feedback, shaped by modules/cv-check/cv-check.ts
  result    Json?
  error     String?
  createdAt DateTime      @default(now())
  paidAt    DateTime?
  doneAt    DateTime?

  payments Payment[]

  @@index([tenantId, createdAt])
}

// What's left of an unpaid order after it was deleted: only its number and the hash of its tracking
// link, so an old link can say "cancelled" instead of "not found". No client details are kept.
model CancelledOrder {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number            Int
  trackingTokenHash String   @unique
  deletedAt         DateTime @default(now())

  @@unique([tenantId, number])
}

enum ActorType {
  CLIENT
  STAFF
  SYSTEM
  MPESA
}

// The order's history. `data` holds structured details (amounts, codes) so the
// text can be rendered per viewer: writers never see money.
model OrderEvent {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind            String
  actorType       ActorType
  actorId         String?
  actor           Membership? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  data            Json?
  visibleToClient Boolean     @default(false)
  at              DateTime    @default(now())

  @@index([orderId, at])
}

// ---------------------------------------------------------------------------
// Payments (M-Pesa Daraja)
// ---------------------------------------------------------------------------

enum PaymentChannel {
  MPESA_STK
  MPESA_PAYBILL
  MANUAL
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

// How a confirmed payment was tied to an order
enum PaymentMatch {
  ORDER_NUMBER
  PHONE_AMOUNT_NAME
  MANUAL
  UNMATCHED
  OTHER
}

model Payment {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // A "Check it yourself" CV check paid for (no order: the client fixes their CV themself)
  cvCheckId         String?
  cvCheck           CvCheck?       @relation(fields: [cvCheckId], references: [id], onDelete: SetNull)
  channel           PaymentChannel
  status            PaymentStatus  @default(PENDING)
  match             PaymentMatch?
  amount            Int
  fee               Int            @default(0)
  phone             String?
  payerName         String?
  accountReference  String?
  // M-Pesa receipt code: unique, so one code can never pay two orders
  receipt           String?        @unique
  checkoutRequestId String?        @unique
  merchantRequestId String?
  raw               Json?
  recordedById      String?
  createdAt         DateTime       @default(now())
  confirmedAt       DateTime?

  @@index([tenantId, status])
  @@index([tenantId, match])
}

model WriterPayout {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  writerId  String
  writer    Membership @relation(fields: [writerId], references: [id], onDelete: Cascade)
  amount    Int
  reference String?
  paidAt    DateTime   @default(now())

  @@index([tenantId, writerId])
}

// ---------------------------------------------------------------------------
// Files (Supabase Storage, private buckets, short-lived signed links only)
// ---------------------------------------------------------------------------

enum FileKind {
  CURRENT_CV
  JOB_ADVERT
  DRAFT
  FINAL
  JOB_POSTER
  // A file the client sent with a change request (e.g. their marked-up copy)
  CHANGES
  OTHER
}

model StoredFile {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind        FileKind
  // Draft number (1, 2, …) for DRAFT files
  version     Int?
  name        String
  mimeType    String
  sizeBytes   Int
  storagePath String    @unique
  // A short message with the file, e.g. what the writer changed in this draft
  note        String?
  uploadedBy  String
  createdAt   DateTime  @default(now())
  // Not used: client files are deleted by delivery date + the retention setting (order-upkeep.service)
  deleteAfter DateTime?
  deletedAt   DateTime?

  @@index([tenantId, orderId])
  @@index([deleteAfter])
}

// ---------------------------------------------------------------------------
// Website content (edited by the owner)
// ---------------------------------------------------------------------------

model Package {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Short name used across the site and admin, e.g. "Professional"
  shortName          String
  name               String
  price              Int
  bestFor            String
  firstDraftHours    Int
  // null = unlimited rounds within revisionWindowDays
  revisionRounds     Int?
  revisionWindowDays Int?
  features           String[]
  popular            Boolean  @default(false)
  visible            Boolean  @default(true)
  sortOrder          Int      @default(0)
  updatedAt          DateTime @updatedAt

  orders Order[]

  @@unique([tenantId, shortName])
}

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  note            String
  price           Int
  firstDraftHours Int      @default(48)
  revisionRounds  Int      @default(1)
  // A CV tailored to one job: the order needs the job (from a job page) or its advert
  needsJobAdvert  Boolean  @default(false)
  visible         Boolean  @default(true)
  sortOrder       Int      @default(0)
  updatedAt       DateTime @updatedAt

  orders Order[]

  @@unique([tenantId, name])
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

model Review {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  name      String
  role      String?
  // Optional photo path; reviews without one show initials
  photo     String?
  rating    Int
  text      String
  status    ReviewStatus @default(PENDING)
  featured  Boolean      @default(false)
  // The client agreed to their review being shown on the website
  consent   Boolean      @default(false)
  // The AI's screening when a client sent it: "ok" or "check" (rude, spam, fake-looking…), and why
  aiFlag    String?
  aiReason  String?
  source    String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  // One review per order (reviews typed in by the owner have no order)
  @@unique([orderId])
  @@index([tenantId, status])
}

model Sample {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String
  role        String
  tag         String
  caption     String
  // Uploaded before/after images (storage paths in the "sample-cvs" bucket). The starting samples
  // have none: theirs are in /public/img/samples, named after the slug.
  beforeImage String?
  afterImage  String?
  published   Boolean @default(true)
  sortOrder   Int     @default(0)

  @@unique([tenantId, slug])
}

enum PostStatus {
  DRAFT
  // A writer sent it to the owner, who publishes it
  REVIEW
  PUBLISHED
}

model Post {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  category    String
  status      PostStatus  @default(DRAFT)
  authorId    String?
  author      Membership? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  cover       String?
  coverAlt    String?
  excerpt     String
  // Markdown
  body        String
  readMinutes Int         @default(5)
  publishedAt DateTime?
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
}

model Faq {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  visible   Boolean @default(true)
  sortOrder Int     @default(0)

  @@index([tenantId, sortOrder])
}

model Homepage {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  headline         String
  highlight        String
  lead             String
  // [{ value, label }], validated by modules/content/content.schema.ts
  stats            Json
  announcementOn   Boolean  @default(false)
  announcementText String   @default("")
  announcementLink String   @default("")
  updatedAt        DateTime @updatedAt
}

// The About page. The owner edits it in Admin → Website content → About page.
model AboutPage {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Shown under "About Jay CVS"
  lead      String
  ownerName String
  ownerRole String
  // Storage path of the owner's photo ("about-photos" bucket); null shows initials
  photo     String?
  // Markdown, a few short paragraphs
  story     String
  // [{ value, label }], validated by modules/content/content.schema.ts
  stats     Json
  updatedAt DateTime @updatedAt
}

// Every content edit is recorded with who made it, so it can be undone
model ContentChange {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     String
  summary     String
  before      Json
  changedById String?
  changedBy   Membership? @relation(fields: [changedById], references: [id], onDelete: SetNull)
  at          DateTime    @default(now())

  @@index([tenantId, at])
}

// ---------------------------------------------------------------------------
// AI tokens: each business has a balance (sum of `delta`); the owner sees tokens, never money
// ---------------------------------------------------------------------------

enum TokenEntryKind {
  GRANT
  TOP_UP
  USAGE
  ADJUSTMENT
}

model TokenLedgerEntry {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind         TokenEntryKind
  // Positive for grants and top-ups, negative for usage
  delta        Int
  feature      String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  memberId     String?
  member       Membership?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  orderId      String?
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  jobId        String?
  job          Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime       @default(now())

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// Jobs inbox: posters dropped in bulk, read by the AI, then approved or discarded by a person
// ---------------------------------------------------------------------------

enum InboxState {
  READING
  CHECK
  APPROVED
  DISCARDED
}

model InboxItem {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  state         InboxState  @default(READING)
  // The poster image (job-posters bucket); on approval it becomes the published job's poster
  posterPath    String
  posterName    String
  posterType    String      @default("image/jpeg")
  posterBytes   Int         @default(0)
  source        String      @default("Uploaded")
  // Text the AI read off the poster, used for the scam checks
  rawText       String      @default("")
  // The AI's second opinion on whether the advert is a scam: "low" | "medium" | "high", and why
  scamRisk      String?
  scamReason    String?
  // The job as read (and corrected) so far; shape is JobInput (modules/jobs/jobs.schema.ts)
  reading       Json?
  // Fields the AI wasn't sure about, and those a person has since confirmed
  unsure        String[]
  checked       String[]
  readError     String?
  discardReason String?
  jobId         String?
  job           Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  inputTokens   Int?
  outputTokens  Int?
  addedById     String?
  addedBy       Membership? @relation("InboxAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     Membership? @relation("InboxDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  readAt        DateTime?
  decidedAt     DateTime?

  @@index([tenantId, state, createdAt])
}

// The writer's AI helper on an order: CV analysis, summary drafts and the final check. Kept so the
// team sees the latest result without paying for it again. result's shape: modules/ai/writer-tools.ts
model OrderAiResult {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // "analysis" | "summary" | "final-check"
  kind        String
  // The file the AI read
  fileName    String
  result      Json
  createdById String?
  createdBy   Membership? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([tenantId, orderId, kind, createdAt])
}
