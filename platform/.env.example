# Copy to .env.local and fill in. Never commit .env.local and never paste keys into chat.

# --- App ---
# Public address of the app (http://localhost:3000 while building)
APP_URL=http://localhost:3000
# Which business to show when the host doesn't match a business domain (local development)
DEFAULT_TENANT_SLUG=jaycvs

# --- Database (Supabase → Project settings → Database → Connection string) ---
# Pooled connection (port 6543, "Transaction pooler"): used by the app
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432): used by Prisma migrations only
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Logins (Better Auth + Google) ---
# Long random string: run `npx @better-auth/cli secret` or `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Google Cloud → APIs & Services → Credentials → OAuth client (web)
# Allowed redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email of the business owner; the seed creates their invite so they can sign in first
OWNER_EMAIL=

# --- Supabase Storage (later phases; files use a mock store until set) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (later phases; AI runs in "pretend" mode until set) ---
ANTHROPIC_API_KEY=
